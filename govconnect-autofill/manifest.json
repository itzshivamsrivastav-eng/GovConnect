{
  "manifest_version": 3,
  "name": "GovConnect Autofill",
  "version": "1.0.0",
  "description": "Autofill supported external forms using information saved in GovConnect.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "GovConnect Autofill"
  }
}